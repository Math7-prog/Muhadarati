# نسخ هذا الملف إلى .env (محلياً فقط، لا يُرفع إلى Git)
# كل الإعدادات هنا تُقرأ من متغيرات البيئة — لا شيء مُثبّت داخل الكود (قرار معماري ثابت).

# --- قاعدة البيانات ---
POSTGRES_USER=muhadarati
POSTGRES_PASSWORD=muhadarati_dev_password
POSTGRES_DB=muhadarati
ConnectionStrings__Default=Host=localhost;Port=5432;Database=muhadarati;Username=muhadarati;Password=muhadarati_dev_password

# --- البريد (Mailpit محلياً) ---
Mail__SmtpHost=localhost
Mail__SmtpPort=1025
Mail__FromAddress=no-reply@muhadarati.local
Mail__UseSsl=false

# --- خدمة التحويل (LibreOffice عبر Gotenberg) ---
Conversion__BaseUrl=http://localhost:3000

# --- تنفيذ الأكواد (Piston) ---
CodeExecution__Provider=Piston
CodeExecution__BaseUrl=http://localhost:2000

# --- الذكاء الاصطناعي (تُضاف لاحقاً في المرحلة 2 — مفتاح لكل مزوّد) ---
# AiProviders__Gemini__ApiKey=
# AiProviders__OpenRouter__ApiKey=

# --- ASP.NET Core Identity / JWT (تُستكمل عند تفعيل الحسابات) ---
# Identity__Jwt__Secret=
